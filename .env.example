# PromptHold Environment Configuration
# Copy this file to .env and adjust values for your environment.

# 1. Environment & Seeding
# Set PROMPT_HOLD_ENV=production in hosted deployments
PROMPT_HOLD_ENV=development
# Set SEED_DEMO_DATA=true during initial testing if you want the 13 demo accounts created
SEED_DEMO_DATA=true

# 2. Primary Database (Managed PostgreSQL in production, SQLite locally)
# Example Pooler URL: postgresql://username:password@pooler.example.com:6543/postgres
DATABASE_URL=sqlite:///./prompthold.db

# 3. Shared Multi-Pod Cache & Rate Limiting (Redis)
# Leave empty locally to use direct database queries; set in multi-pod production
REDIS_URL=

# 4. Automatic Issue Creation for User Feedback / Complaints
# Format: owner/repository (e.g. your-username/prompthold-mcp)
GITHUB_ISSUE_REPO=
# Personal Access Token (Fine-grained token with "Issues: Read and write" permission on the repo)
GITHUB_ISSUE_TOKEN=

# 5. Optional Single Sign-On (SSO / OAuth)
# Copy Web API Key from your Auth provider console
FIREBASE_WEB_API_KEY=

# 6. Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
