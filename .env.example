# =============================================================================
# PromptHold Multi-Tier Database & Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#
# PromptHold uses a multi-tier database architecture:
# - Free / Community Tier: Stored in Supabase PostgreSQL
# - Paid Tiers (Pro, Team, Enterprise): Stored in Neon Serverless PostgreSQL

# -----------------------------------------------------------------------------
# 1. Environment & Seeding
# -----------------------------------------------------------------------------
# Set PROMPT_HOLD_ENV=production in hosted deployments
PROMPT_HOLD_ENV=development
# Set SEED_DEMO_DATA=true during initial testing if you want the 13 demo accounts created
SEED_DEMO_DATA=true

# -----------------------------------------------------------------------------
# 2. Paid Tiers: Neon Serverless PostgreSQL (Pro, Team, Enterprise)
# -----------------------------------------------------------------------------
# Example Pooled URL: postgresql://neondb_owner:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=postgresql://neondb_owner:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production
# Legacy fallback alias for Neon
DATABASE_URL=postgresql://neondb_owner:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# 3. Free / Community Tier: Supabase PostgreSQL (Community)
# -----------------------------------------------------------------------------
# Obtain from: Supabase Console -> Project Settings -> Database -> Connection String
#
# Transaction Pooler (Recommended for pooled apps, port 6543):
# SUPABASE_DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Direct Connection (Session mode, port 5432):
# SUPABASE_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
SUPABASE_DATABASE_URL=
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# -----------------------------------------------------------------------------
# 4. Shared Multi-Pod Cache & Rate Limiting (Redis)
# -----------------------------------------------------------------------------
# Leave empty locally to use in-memory rate limiting; set in multi-pod production
REDIS_URL=

# -----------------------------------------------------------------------------
# 5. Automatic Issue Creation for User Feedback / Complaints
# -----------------------------------------------------------------------------
# Format: owner/repository (e.g. your-username/prompthold-mcp)
GITHUB_ISSUE_REPO=
# Personal Access Token (Fine-grained token with "Issues: Read and write" permission on the repo)
GITHUB_ISSUE_TOKEN=

# -----------------------------------------------------------------------------
# 6. Hybrid Search & Semantic Embeddings (Google Gemini text-embedding-004)
# -----------------------------------------------------------------------------
# Obtain free API key from Google AI Studio (https://aistudio.google.com/app/apikey)
# If omitted or empty, PromptHold automatically falls back to fuzzy/lexical search.
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# 7. Firebase Auth & Google Sign-In Configuration
# -----------------------------------------------------------------------------
# Backend Verification (Google / Firebase ID token validation):
FIREBASE_WEB_API_KEY=

# Frontend Firebase Web SDK (Vite Client):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# 7. Allowed CORS Origins (comma-separated)
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# 8. Production Proxy & Migration Hardening
# -----------------------------------------------------------------------------
# Set TRUST_PROXY_HEADERS=true when behind Cloudflare or an edge reverse proxy
# to trust cf-connecting-ip / x-forwarded-for headers for rate limiting and audit logs
TRUST_PROXY_HEADERS=false

# Set AUTO_MIGRATE_DB=false in production if running migrations via `python migrate.py`
# under a separate deployment role with DDL privileges.
AUTO_MIGRATE_DB=true

# -----------------------------------------------------------------------------
# 9. Polar.sh Merchant of Record Billing (SaaS Tiers & Subscriptions)
# -----------------------------------------------------------------------------
# Sign up at https://polar.sh (Individual account - no Trade License or BIN required).
# Obtain Access Token from: Settings -> Developers -> Access Tokens
POLAR_ACCESS_TOKEN=
# Webhook secret from: Settings -> Webhooks -> Add Endpoint (point to /api/webhooks/polar)
POLAR_WEBHOOK_SECRET=
# 'sandbox' for testing, 'production' for live payments
POLAR_ENVIRONMENT=sandbox
# Product / Price IDs created in Polar Dashboard for paid tiers
POLAR_PRO_PRODUCT_ID=
POLAR_TEAM_PRODUCT_ID=
# Optional redirect URL upon successful checkout
POLAR_CHECKOUT_SUCCESS_URL=http://localhost:5173/?billing=success

