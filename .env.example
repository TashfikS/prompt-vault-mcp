# =============================================================================
# PromptHold Multi-Tier Database & Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#
# PromptHold uses a multi-tier database architecture:
# - Free / Community Tier: Stored in Supabase PostgreSQL
# - Paid Tiers (Pro, Team, Enterprise): Stored in Neon Serverless PostgreSQL

# -----------------------------------------------------------------------------
# 1. Environment & Seeding
# -----------------------------------------------------------------------------
# Set PROMPT_HOLD_ENV=production in hosted deployments
PROMPT_HOLD_ENV=development
# Set SEED_DEMO_DATA=true during initial testing if you want the 13 demo accounts created
SEED_DEMO_DATA=true

# -----------------------------------------------------------------------------
# 2. Paid Tiers: Neon Serverless PostgreSQL (Pro, Team, Enterprise)
# -----------------------------------------------------------------------------
# Example Pooled URL: postgresql://neondb_owner:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=postgresql://neondb_owner:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production
# Legacy fallback alias for Neon
DATABASE_URL=postgresql://neondb_owner:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# 3. Free / Community Tier: Supabase PostgreSQL (Community)
# -----------------------------------------------------------------------------
# Obtain from: Supabase Console -> Project Settings -> Database -> Connection String
#
# Transaction Pooler (Recommended for pooled apps, port 6543):
# SUPABASE_DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Direct Connection (Session mode, port 5432):
# SUPABASE_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
SUPABASE_DATABASE_URL=
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# -----------------------------------------------------------------------------
# 4. Shared Multi-Pod Cache & Rate Limiting (Redis)
# -----------------------------------------------------------------------------
# Leave empty locally to use in-memory rate limiting; set in multi-pod production
REDIS_URL=

# -----------------------------------------------------------------------------
# 5. Automatic Issue Creation for User Feedback / Complaints
# -----------------------------------------------------------------------------
# Format: owner/repository (e.g. your-username/prompthold-mcp)
GITHUB_ISSUE_REPO=
# Personal Access Token (Fine-grained token with "Issues: Read and write" permission on the repo)
GITHUB_ISSUE_TOKEN=

# -----------------------------------------------------------------------------
# 6. Optional Single Sign-On (SSO / OAuth)
# -----------------------------------------------------------------------------
# Copy Web API Key from your Auth provider console
FIREBASE_WEB_API_KEY=

# -----------------------------------------------------------------------------
# 7. Allowed CORS Origins (comma-separated)
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
